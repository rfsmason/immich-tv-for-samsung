# Machine-specific settings for npm run tizen:deploy and npm run tizen:package.
# Copy to .env.tizen (ignored by git) and fill in your own values.

# The TV's SDB address: its IP address and the Developer Mode port (26101).
TIZEN_TV_HOST=192.168.1.50:26101

# The target name that `sdb devices` shows for your TV, for example its model code.
TIZEN_TARGET_NAME=replace-with-your-tv-target-name

# The Tizen Studio certificate profile used to sign the widget.
TIZEN_CERT_PROFILE=replace-with-your-certificate-profile

# Optional overrides.
# TIZEN_APP_ID=imchTV0001.ImmichTV
# TIZEN_STUDIO_HOME=/path/to/tizen-studio
